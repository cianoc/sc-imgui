[submodule "native/third_party/imgui"]
	path = native/third_party/imgui
	url = https://github.com/ocornut/imgui.git
	# Comes from ImGui's docking branch. The pinned commit is what is used;
	# never run `git submodule update --remote` (see native/README.md).
[submodule "native/third_party/cimgui"]
	path = native/third_party/cimgui
	url = https://github.com/cimgui/cimgui.git
	# Comes from cimgui's docking_inter branch. The pinned commit is what is used;
	# never run `git submodule update --remote` (see native/README.md).
[submodule "native/third_party/implot"]
	path = native/third_party/implot
	url = https://github.com/epezent/implot.git
[submodule "native/third_party/cimplot"]
	path = native/third_party/cimplot
	url = https://github.com/cimgui/cimplot.git
[submodule "native/third_party/glfw"]
	path = native/third_party/glfw
	url = https://github.com/glfw/glfw.git
